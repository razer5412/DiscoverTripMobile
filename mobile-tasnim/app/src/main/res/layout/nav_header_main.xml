<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/orange"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="40dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- initiale de la personne connectée (remplie dans le code) -->
    <TextView
        android:id="@+id/tvHeaderInitiale"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_logo"
        android:contentDescription="@string/header_logo_description"
        android:gravity="center"
        android:textColor="@color/orange"
        android:textSize="26sp"
        android:textStyle="bold"
        tools:text="D" />

    <TextView
        android:id="@+id/tvHeaderNom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="@string/header_titre_visiteur" />

    <TextView
        android:id="@+id/tvHeaderEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/orange_clair"
        android:textSize="13sp"
        tools:text="@string/header_sous_titre_visiteur" />
</LinearLayout>